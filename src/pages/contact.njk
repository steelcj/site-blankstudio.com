---
routeKey: "contact"
pageKey: "contact"
css: ["home", "contact"]
footerMuted: false
mobileCta2Contact: "phoneHref"
ctaBtn1Contact: "phoneHref"
ctaBtn2Contact: "whatsapp"
ctaBtn2Attrs: " target=\"_blank\" rel=\"noopener\""
---
{% extends "layouts/base.njk" %}

{% block body %}
    <!-- ============ HERO + FORM ============ -->
    <section class="hero hero--page hero--contact" id="hero">
      <div class="hero__grid-bg" aria-hidden="true"></div>
      <div class="container">
        <div class="hero__inner">
          <div class="hero__content">
            <span class="eyebrow reveal">{{ t.contact.hero.eyebrow | safe }}</span>
            <h1 class="h-xl hero__title">
{% for line in t.contact.hero.titleLines %}              <span class="line"><span>{{ line | safe }}</span></span>
{% endfor %}            </h1>
            <p class="page-sub reveal" data-delay="1">
              {{ t.contact.hero.sub | safe }}
            </p>
            <p class="page-body reveal" data-delay="2">
              {{ t.contact.hero.body | safe }}
            </p>
            <p class="hero__micro reveal" data-delay="3">{{ t.contact.hero.micro | safe }}</p>

            <div class="contact-methods reveal" data-delay="3">
              <div class="cm" id="email"><span class="cm__k">{{ t.contact.methods.email | safe }}</span><a class="cm__v" href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></div>
              <div class="cm" id="phone"><span class="cm__k">{{ t.contact.methods.call | safe }}</span><a class="cm__v" href="{{ site.contact.phoneHref }}">{{ site.contact.phoneDisplay }}</a></div>
              <div class="cm" id="whatsapp"><span class="cm__k">{{ t.contact.methods.whatsapp | safe }}</span><a class="cm__v" href="{{ site.contact.whatsapp }}" target="_blank" rel="noopener">{{ site.contact.phoneDisplay }}</a></div>
              <div class="cm" id="instagram"><span class="cm__k">{{ t.contact.methods.instagram | safe }}</span><a class="cm__v" href="{{ site.contact.instagram }}" target="_blank" rel="noopener">{{ site.contact.instagramHandle }}</a></div>
              <div class="cm"><span class="cm__k">{{ t.contact.methods.responseKey | safe }}</span><span class="cm__v">{{ t.contact.methods.responseValue | safe }}</span></div>
            </div>
          </div>

          <!-- Brief form -->
          <form class="cform reveal" id="briefForm" name="contact" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" data-delay="1" novalidate>
            <input type="hidden" name="form-name" value="contact" />
            <input type="hidden" name="locale" value="{{ locale.code }}" />
            <input type="hidden" id="f-package" name="package" value="" />
            <p hidden aria-hidden="true"><label>{{ t.contact.form.honeypotLabel | safe }} <input name="bot-field" /></label></p>
            <div class="cform__head"><span>{{ t.contact.form.heading | safe }}</span><span>{{ t.contact.form.step | safe }}</span></div>
            <p class="cform__applying" id="applyingNote" hidden></p>
            <div class="field--row">
              <div class="field">
                <label for="f-name">{{ t.contact.form.nameLabel | safe }}</label>
                <input id="f-name" name="name" type="text" placeholder="{{ t.contact.form.namePlaceholder | safe }}" required />
              </div>
              <div class="field">
                <label for="f-email">{{ t.contact.form.emailLabel | safe }}</label>
                <input id="f-email" name="email" type="email" placeholder="{{ t.contact.form.emailPlaceholder | safe }}" required />
              </div>
            </div>
            <div class="field--row">
              <div class="field">
                <label for="f-company">{{ t.contact.form.companyLabel | safe }}</label>
                <input id="f-company" name="company" type="text" placeholder="{{ t.contact.form.companyPlaceholder | safe }}" />
              </div>
            </div>
            <div class="field">
              <label for="f-service">{{ t.contact.form.serviceLabel | safe }}</label>
              <select id="f-service" name="service">
                <option>{{ t.contact.form.serviceOpt1 | safe }}</option>
                <option>{{ t.contact.form.serviceOpt2 | safe }}</option>
                <option>{{ t.contact.form.serviceOpt3 | safe }}</option>
                <option>{{ t.contact.form.serviceOpt4 | safe }}</option>
                <option>{{ t.contact.form.serviceOpt5 | safe }}</option>
                <option>{{ t.contact.form.serviceOpt6 | safe }}</option>
                <option>{{ t.contact.form.serviceOpt7 | safe }}</option>
                <option>{{ t.contact.form.serviceOpt8 | safe }}</option>
                <option>{{ t.contact.form.serviceOpt9 | safe }}</option>
              </select>
            </div>
            <div class="field">
              <label for="f-message">{{ t.contact.form.messageLabel | safe }}</label>
              <textarea id="f-message" name="message" placeholder="{{ t.contact.form.messagePlaceholder | safe }}" required></textarea>
            </div>
            <button type="submit" class="btn btn--primary btn--lg">{{ t.contact.form.submit | safe }}</button>
            <p class="cform__note">{{ t.contact.form.note | safe }}</p>
            <p class="cform__sent">{{ t.contact.form.sent | safe }}</p>
          </form>
        </div>
      </div>
    </section>

    <!-- ============ IMAGE BAND ============ -->
    <section class="showcase" aria-label="{{ t.contact.showcase.eyebrow | safe }}">
      <div class="container showcase__inner">
        <span class="eyebrow reveal">{{ t.contact.showcase.aria | safe }}</span>
        <h2 class="showcase__title reveal" data-delay="1">{{ t.contact.showcase.heading | safe }}</h2>
        <p class="showcase__sub reveal" data-delay="2">{{ t.contact.showcase.sub | safe }}</p>
      </div>
    </section>

    <!-- ============ WHAT HAPPENS NEXT ============ -->
    <section class="sec" id="next">
      <div class="container">
        <div class="sec-head">
          <div class="sec-head__main">
            <span class="eyebrow reveal">{{ t.contact.next.eyebrow | safe }}</span>
            <h2 class="section-title reveal" data-delay="1">{{ t.contact.next.heading | safe }}</h2>
          </div>
        </div>

        <div class="grid-table">
          <div class="steps steps--4">
            <div class="step reveal">
              <span class="step__no">01</span>
              <h3>{{ t.contact.next.s1Title | safe }}</h3>
              <p>{{ t.contact.next.s1Body | safe }}</p>
              <span class="step__time">{{ t.contact.next.s1Time | safe }}</span>
            </div>
            <div class="step reveal" data-delay="1">
              <span class="step__no">02</span>
              <h3>{{ t.contact.next.s2Title | safe }}</h3>
              <p>{{ t.contact.next.s2Body | safe }}</p>
              <span class="step__time">{{ t.contact.next.s2Time | safe }}</span>
            </div>
            <div class="step reveal" data-delay="2">
              <span class="step__no">03</span>
              <h3>{{ t.contact.next.s3Title | safe }}</h3>
              <p>{{ t.contact.next.s3Body | safe }}</p>
              <span class="step__time">{{ t.contact.next.s3Time | safe }}</span>
            </div>
            <div class="step reveal" data-delay="3">
              <span class="step__no">04</span>
              <h3>{{ t.contact.next.s4Title | safe }}</h3>
              <p>{{ t.contact.next.s4Body | safe }}</p>
              <span class="step__time">{{ t.contact.next.s4Time | safe }}</span>
            </div>
          </div>
        </div>

        <div class="section-foot">
          <a href="{{ urls.contact }}" class="link-arrow reveal">{{ t.contact.next.emailLink | safe }} <span>&rarr;</span></a>
        </div>
      </div>
    </section>

{% include "partials/final-cta.njk" %}
{% endblock %}

{% block scripts %}
  <script>
    (function () {
      var f = document.getElementById("briefForm");
      if (!f) return;

      // Pre-fill "Applying for" when arriving from a Services package button.
      try {
        var pkg = new URLSearchParams(location.search).get("package");
        if (pkg) {
          var pf = document.getElementById("f-package");
          if (pf) pf.value = pkg;
          var note = document.getElementById("applyingNote");
          if (note) { note.textContent = {{ t.contact.script.applyingPrefix | dump | safe }} + pkg; note.hidden = false; }
        }
      } catch (err) {}

      var g = function (n) { var el = f.elements[n]; return el ? String(el.value).trim() : ""; };

      f.addEventListener("submit", function (e) {
        e.preventDefault();
        if (!g("name") || !g("email") || !g("message")) {
          [["name","f-name"],["email","f-email"],["message","f-message"]].forEach(function (p) {
            var el = document.getElementById(p[1]);
            if (el && !g(p[0])) el.style.borderColor = "#e0564f";
          });
          return;
        }
        var btn = f.querySelector("button[type=submit]");
        if (btn) { btn.disabled = true; btn.textContent = {{ t.common.form.sending | dump | safe }}; }
        fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(new FormData(f)).toString()
        }).then(function (r) {
          if (!r.ok) throw new Error("submit failed");
          f.classList.add("is-sent");
          f.reset();
        }).catch(function () {
          if (btn) { btn.disabled = false; btn.textContent = {{ t.contact.form.submit | dump | safe }}; }
          window.location.href =
            "mailto:{{ site.contact.email }}?subject=" + encodeURIComponent({{ t.contact.script.mailSubject | dump | safe }} + g("name")) +
            "&body=" + encodeURIComponent({{ t.common.form.mailName | dump | safe }} + g("name") + "\n" + {{ t.common.form.mailEmail | dump | safe }} + g("email") + "\n\n" + g("message"));
        });
      });
    })();
  </script>
{% endblock %}
