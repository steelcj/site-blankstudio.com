        <div class="packages__cta reveal">
          <a href="{{ urls.contact }}?package=Discovery%20Call" class="btn btn--dark btn--lg">{{ t.services.packages.ctaPrimary | safe }}</a>
          <a href="{{ site.contact.whatsapp }}?text=Hi%20BLNK%2C%20I%27d%20like%20to%20discuss%20working%20together." target="_blank" rel="noopener" class="btn btn--outline btn--lg">{{ t.services.packages.ctaWhatsapp | safe }}</a>
