---
routeKey: "services"
pageKey: "services"
css: ["home", "services"]
footerMuted: true
---
{% extends "layouts/base.njk" %}

{% block body %}
    <!-- ============ HERO ============ -->
    <section class="hero hero--page" id="hero">
      <div class="hero__grid-bg" aria-hidden="true"></div>
      <div class="container hero__inner">
        <div class="hero__content">
          <span class="eyebrow reveal">{{ t.services.hero.eyebrow | safe }}</span>
          <h1 class="h-xl hero__title">
{% for line in t.services.hero.titleLines %}              <span class="line"><span>{{ line | safe }}</span></span>
{% endfor %}            </h1>
          <p class="page-sub reveal" data-delay="1">
            {{ t.services.hero.sub | safe }}
          </p>
          <div class="hero__cta reveal" data-delay="2">
            <a href="#packages" class="btn btn--primary btn--lg">{{ t.services.hero.ctaPrimary | safe }}</a>
            <a href="{{ site.contact.whatsapp }}" class="btn btn--outline btn--lg">{{ t.services.common.enquire | safe }}</a>
          </div>
        </div>

        <!-- Service directory -->
        <nav class="dir reveal" data-delay="2" aria-label="{{ t.services.dir.aria | safe }}">
          <div class="dir__head"><span>{{ t.services.dir.heading | safe }}</span><span>07</span></div>
          <a href="#brand"><span class="n">01</span> {{ t.services.dir.brand | safe }} <span class="arr">&rarr;</span></a>
          <a href="#website"><span class="n">02</span> {{ t.services.dir.website | safe }} <span class="arr">&rarr;</span></a>
          <a href="#social"><span class="n">03</span> {{ t.services.dir.social | safe }} <span class="arr">&rarr;</span></a>
          <a href="#seo"><span class="n">04</span> {{ t.services.dir.seo | safe }} <span class="arr">&rarr;</span></a>
          <a href="#content"><span class="n">05</span> {{ t.services.dir.content | safe }} <span class="arr">&rarr;</span></a>
          <a href="#ads"><span class="n">06</span> {{ t.services.dir.ads | safe }} <span class="arr">&rarr;</span></a>
          <a href="#decks"><span class="n">07</span> {{ t.services.dir.pitch | safe }} <span class="arr">&rarr;</span></a>
        </nav>
      </div>
    </section>

    <!-- ============ SERVICE GRID ============ -->
    <section class="sec" id="services">
      <div class="container">
        <div class="sec-head">
          <div class="sec-head__main">
            <span class="eyebrow reveal">{{ t.services.build.eyebrow | safe }}</span>
            <h2 class="section-title reveal" data-delay="1">{{ t.services.build.titleLine1 | safe }} <em>{{ t.services.build.titleEm | safe }}</em> {{ t.services.build.titleLine2 | safe }}</h2>
          </div>
        </div>

        <div class="grid-table">
          <div class="svc-grid">
            <article class="svc-card reveal">
              <span class="svc-card__no">01 / 07</span>
              <h3>{{ t.services.build.c1Title | safe }}</h3>
              <div class="svc-card__row"><span class="svc-card__k">{{ t.services.common.problemLabel | safe }}</span><p>{{ t.services.build.c1Problem | safe }}</p></div>
              <div class="svc-card__row"><span class="svc-card__k">{{ t.services.common.buildLabel | safe }}</span><p>{{ t.services.build.c1Build | safe }}</p></div>
              <div class="svc-card__row"><span class="svc-card__k">{{ t.services.common.bestLabel | safe }}</span><p>{{ t.services.build.c1Best | safe }}</p></div>
              <a href="{{ site.contact.whatsapp }}" class="s-card__link">{{ t.services.common.enquire | safe }} <span>&rarr;</span></a>
            </article>

            <article class="svc-card reveal" data-delay="1">
              <span class="svc-card__no">02 / 07</span>
