              <div class="svc-card__row"><span class="svc-card__k">{{ t.services.common.buildLabel | safe }}</span><p>{{ t.services.build.c2Build | safe }}</p></div>
              <div class="svc-card__row"><span class="svc-card__k">{{ t.services.common.bestLabel | safe }}</span><p>{{ t.services.build.c2Best | safe }}</p></div>
              <a href="{{ site.contact.whatsapp }}" class="s-card__link">{{ t.services.common.enquire | safe }} <span>&rarr;</span></a>
