              <div class="svc-card__row"><span class="svc-card__k">{{ t.services.common.buildLabel | safe }}</span><p>{{ t.services.build.c5Build | safe }}</p></div>
              <div class="svc-card__row"><span class="svc-card__k">{{ t.services.common.bestLabel | safe }}</span><p>{{ t.services.build.c5Best | safe }}</p></div>
