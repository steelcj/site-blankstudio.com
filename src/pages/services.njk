          </div>
        </div>
      </div>
    </section>

    <!-- ============ SHOWCASE (lifestyle band) ============ -->
    <section class="showcase" aria-label="{{ t.services.showcase.eyebrow | safe }}">
      <div class="container showcase__inner">
        <span class="eyebrow reveal">{{ t.services.showcase.aria | safe }}</span>
        <h2 class="showcase__title reveal" data-delay="1">{{ t.services.showcase.titleLine1 | safe }} <em>{{ t.services.showcase.titleLine2 | safe }}</em></h2>
        <p class="showcase__sub reveal" data-delay="2">{{ t.services.showcase.sub | safe }}</p>
      </div>
    </section>

    <!-- ============ SERVICE DETAIL BLOCKS ============ -->
