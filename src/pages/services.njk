              </div>
              <div class="svc-card__rows">
                <div class="svc-card__row"><span class="svc-card__k">{{ t.services.common.problemLabel | safe }}</span><p>{{ t.services.build.c7Problem | safe }}</p></div>
                <div class="svc-card__row"><span class="svc-card__k">{{ t.services.common.buildLabel | safe }}</span><p>{{ t.services.build.c7Build | safe }}</p></div>
                <div class="svc-card__row"><span class="svc-card__k">{{ t.services.common.bestLabel | safe }}</span><p>{{ t.services.build.c7Best | safe }}</p></div>
              </div>
